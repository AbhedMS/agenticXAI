# Hugging Face token (Llama 3.1 is gated: accept the license on its model page first).
# On Colab you can instead store it in the Secrets panel as HF_TOKEN.
HF_TOKEN=hf_...

# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct   # default; any "org/name" HF repo runs locally
# LLAMA_QUANTIZATION=auto                       # auto | 4bit | 8bit | none
# MAX_NEW_TOKENS=512
# RECURSION_LIMIT=20

# Optional: hosted model for comparison, e.g. LLM_MODEL=anthropic:claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
